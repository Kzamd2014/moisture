#!/usr/bin/env bash
# Blocks committing real Wi-Fi credentials to this PUBLIC repo.
#
# Install (NOT automatic on a fresh clone — .git/config is not cloned):
#     git config core.hooksPath .githooks
#
# Design note: this hook FAILS CLOSED. It requires positive proof that the
# placeholders are present. An unparseable, renamed, or reformatted sketch is
# treated as a leak, not as "nothing found". The previous version inferred
# safety from a regex not matching, which silently disarmed on whitespace or
# pointer-style changes (e.g. Arduino IDE Auto-Format turning `char* X` into
# `char *X`).

set -euo pipefail

SKETCH="firmware/moisture/moisture.ino"
PLACEHOLDER_SSID='"your-network-name"'
PLACEHOLDER_PASS='"your-password"'

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged_files" ] && exit 0

fail=0
reasons=()

# --- Check 1: the sketch must still hold both placeholders -------------------
if grep -qx "$SKETCH" <<<"$staged_files"; then
  staged=$(git show ":$SKETCH")

  if ! grep -qF "$PLACEHOLDER_SSID" <<<"$staged"; then
    fail=1; reasons+=("$SKETCH does not contain the placeholder SSID $PLACEHOLDER_SSID")
  fi
  if ! grep -qF "$PLACEHOLDER_PASS" <<<"$staged"; then
    fail=1; reasons+=("$SKETCH does not contain the placeholder password $PLACEHOLDER_PASS")
  fi
fi

# --- Check 2: no build output (compiled .bin embeds the PSK in cleartext) ----
if grep -qE '(^|/)build/|\.(bin|elf|hex)$' <<<"$staged_files"; then
  fail=1; reasons+=("build output staged — compiled binaries contain WIFI_PASSWORD as a plaintext string")
fi

# --- Check 3: optional denylist of literal secrets, scanned across ALL files -
# Create .git/secrets-denylist (untracked, never cloned), one literal per line,
# holding your real SSID and password. Catches leaks via any path: serial logs
# pasted into docs, sketch copies, editor backups.
DENYLIST="$(git rev-parse --git-dir)/secrets-denylist"
if [ -s "$DENYLIST" ]; then
  if git diff --cached -U0 | grep -Ff "$DENYLIST" -q; then
    fail=1; reasons+=("a literal from .git/secrets-denylist appears in the staged diff")
  fi
fi

if [ "$fail" -eq 1 ]; then
  {
    echo
    echo "  ✋ COMMIT BLOCKED — possible credential leak"
    echo
    for r in "${reasons[@]}"; do echo "     • $r"; done
    echo
    echo "  This repo is PUBLIC (github.com/Kzamd2014/moisture)."
    echo
    echo "  To commit other work while keeping your credentials locally:"
    echo
    echo "      git stash push $SKETCH"
    echo "      git commit ..."
    echo "      git stash pop"
    echo
  } >&2
  exit 1
fi

exit 0
